rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // -----------------------------------------------------
    // FUNCIONES DE APOYO (HELPERS)
    // -----------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRoleByDoc(docId) {
      return exists(/databases/$(database)/documents/Usuarios/$(docId)) 
        ? get(/databases/$(database)/documents/Usuarios/$(docId)).data.get('rol', 
            get(/databases/$(database)/documents/Usuarios/$(docId)).data.get('role', 'sin_acceso')
          )
        : 'sin_acceso';
    }

    function getUserRole() {
      return (request.auth != null && 'email' in request.auth.token && exists(/databases/$(database)/documents/Usuarios/$(request.auth.token.email)))
        ? getUserRoleByDoc(request.auth.token.email)
        : (request.auth != null ? getUserRoleByDoc(request.auth.uid) : 'sin_acceso');
    }

    function isAdmin() {
      return getUserRole() in ['admin', 'superadmin', 'administrador', 'global', 'ADMIN', 'SUPERADMIN', 'ADMINISTRADOR', 'GLOBAL'];
    }

    function isSuperAdmin() {
      return getUserRole() in ['superadmin', 'SUPERADMIN'];
    }

    function isOperadorOrAdmin() {
      return getUserRole() in [
        'admin', 'superadmin', 'administrador', 'global', 'operador', 'enfermero',
        'ADMIN', 'SUPERADMIN', 'ADMINISTRADOR', 'GLOBAL', 'OPERADOR', 'ENFERMERO'
      ];
    }

    // Personal que gestiona compras y bodega (excluye al enfermero)
    function isStaff() {
      return getUserRole() in [
        'admin', 'superadmin', 'administrador', 'global', 'operador',
        'ADMIN', 'SUPERADMIN', 'ADMINISTRADOR', 'GLOBAL', 'OPERADOR'
      ];
    }

    // Rol limitado «transitoria»: solo ve la Bodega transitoria y asigna estantes (ubicacionEstante)
    function isTransitoria() {
      return getUserRole() in ['transitoria', 'TRANSITORIA'];
    }

    function isOwner(userId) {
      // Comparación relajada para asegurar lectura propia
      return isAuthenticated() && (request.auth.uid == userId || request.auth.token.email == userId);
    }

    // Usuario autenticado que además tiene un rol asignado en /Usuarios.
    // Una cuenta recién registrada, sin perfil, queda como 'sin_acceso'.
    function hasRole() {
      return isAuthenticated() && getUserRole() != 'sin_acceso';
    }

    // Correo institucional REAL: dominio anclado tras la arroba y correo verificado.
    // (Firebase Auth no comprueba que el correo sea del dueño si no está verificado.)
    function isInstitutionalEmail() {
      return isAuthenticated()
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@(comunel|cormunel|cormumel)\\.cl');
    }

    // -----------------------------------------------------
    // GESTIÓN DE USUARIOS MÉTODOS RBAC
    // -----------------------------------------------------
    match /Usuarios/{userId} {
      // LECTURA: Operadores y admins pueden ver a todos (necesario para listar enfermeros).
      allow read: if isOperadorOrAdmin() || isOwner(userId);
      // CREACIÓN: admin, operador (solo enfermeros) o el propio titular con correo
      // institucional verificado que crea SU perfil inicial de superadmin (arranque).
      allow create: if isAdmin()
        || (getUserRole() == 'operador' && request.resource.data.rol == 'enfermero')
        || (isOwner(userId) && isInstitutionalEmail() && request.resource.data.rol == 'superadmin');
      // ACTUALIZACIÓN: Un usuario regular NO puede modificar su propio campo 'rol' o 'role'
      allow update: if isAdmin() || (isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['rol', 'role'])));
      allow delete: if isAdmin();
    }

    // -----------------------------------------------------
    // GESTIÓN DE BODEGAS (Sucursales)
    // -----------------------------------------------------
    match /Bodegas/{bodegaId} {
      allow read: if hasRole();
      allow write: if isAdmin();
    }

    // Estantes y ubicaciones de cada bodega (códigos como BS-A01). No se borran: se archivan.
    // Qué cantidad de cada producto hay en cada ubicación (el stock total sigue en Insumos).
    match /Asignaciones_Ubicacion/{id} {
      allow read: if hasRole();
      allow create, update, delete: if isStaff();
    }

    match /Bodegas/{bodegaId}/Ubicaciones/{codigo} {
      allow read: if hasRole();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // -----------------------------------------------------
    // CIBERSEGURIDAD: Reglas de la Colección 'Insumos'
    // -----------------------------------------------------
    match /Insumos/{insumoId} {
      allow read: if hasRole();
      allow create: if isOperadorOrAdmin();
      allow update: if isOperadorOrAdmin()
        || (isTransitoria() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ubicacionEstante', 'updatedAt']));
      allow delete: if isAdmin();
    }
    
    // -----------------------------------------------------
    // AUDITORÍA INMUTABLE: Log de cambios locales
    // -----------------------------------------------------
    match /Insumos/{insumoId}/audit_logs/{logId} {
      allow create: if hasRole() && request.resource.data.action == 'ACTUALIZACION';
      allow read: if isAdmin(); // Solo admins pueden auditar inventario detallado
      allow update: if false; 
      allow delete: if isSuperAdmin();
    }

    // -----------------------------------------------------
    // HISTORIAL GLOBAL (Bitácora de todos los movimientos)
    // -----------------------------------------------------
    match /Historial_Movimientos/{movId} {
      allow read: if hasRole(); // Solo usuarios con rol asignado (el historial antiguo puede contener RUT de pacientes)
      allow create: if hasRole();
      // Solo el superadministrador, y solo para quitar datos de pacientes antiguos (anonimizar-pacientes.js)
      allow update: if isSuperAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rutPaciente', 'nombrePaciente', 'camaPaciente', 'document']);
      // Corrección de un ingreso de proveedor por un administrador (v21.121): solo estos campos y solo ese tipo
      allow update: if isAdmin() && resource.data.type == 'INGRESO_PROVEEDOR'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity', 'batch', 'expirationDate', 'provider', 'purchaseType', 'document', 'observations', 'tipoInsumo', 'date', 'insumoId', 'editado', 'editadoPor', 'editadoEn', 'ediciones']);
      allow delete: if isSuperAdmin();
    }

    // -----------------------------------------------------
    // INFORMES Y AUDITORÍA DE ERRORES
    // -----------------------------------------------------
    match /informes/{id} {
       allow read: if hasRole();   // el Inicio lee las fechas de inventario general
       allow write: if isAdmin();  // solo admin modificas
    }

    match /Logs_Sistema/{id} {
       allow read, write: if isAdmin();
    }
    
    match /Solicitudes_Criticas/{id} {
       allow read, write: if isAdmin();
    }

    // PEDIR INSUMOS SIN CUENTA (v21.193): solicitar.html entra con inicio de sesión ANÓNIMO.
    // Quien pide solo puede crear su solicitud (estado NUEVA, a su nombre) y leer las suyas y la lista pública de productos.
    // Bodega (staff) las ve todas, cambia el estado y publica la lista (catalogo-publico).
    match /Solicitudes_Insumos/{id} {
      // (v21.212) Página «Pedir insumos»: quien pide sin cuenta (anónimo) o la encargada de una bodega de uso (rol transitoria).
      // Las decisiones de bodega (lotes, movimientos, cuadre, correlativo) solo las escribe el staff.
      allow read: if isStaff()
        || (request.auth != null && (id == 'catalogo-publico' || resource.data.uid == request.auth.uid));
      allow create: if isStaff()
        || (request.auth != null
            && request.resource.data.keys().hasOnly(['tipo', 'numero', 'estado', 'uid', 'requester', 'solicitante', 'correo', 'servicio', 'bodega', 'destino', 'categoria', 'nota', 'lineas', 'creadoEn', 'historial', 'origen', 'conteo', 'correlativo', 'correlativoN', 'correlativoAnio'])
            // N° SOL al enviar (v21.219): solo si el contador del año queda apuntando a esta solicitud con ese mismo número
            && (!('correlativo' in request.resource.data)
                || (request.resource.data.correlativoAnio is string && request.resource.data.correlativoAnio.matches('^[0-9]{4}$')
                    && request.resource.data.correlativo.matches('^SOL-' + request.resource.data.correlativoAnio + '-[0-9]{4,6}$')
                    && getAfter(/databases/$(database)/documents/Contadores/$('correlativo-solicitudes-' + request.resource.data.correlativoAnio)).data.ultima == id
                    && getAfter(/databases/$(database)/documents/Contadores/$('correlativo-solicitudes-' + request.resource.data.correlativoAnio)).data.valor == request.resource.data.correlativoN))
            && request.resource.data.numero == id
            && request.resource.data.tipo == 'SOLICITUD_INSUMOS'
            && request.resource.data.estado == 'NUEVA'
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.lineas is list && request.resource.data.lineas.size() > 0
            && request.resource.data.lineas.size() <= (isTransitoria() ? 200 : 80)
            && request.resource.data.solicitante is string && request.resource.data.solicitante.size() <= 120
            && request.resource.data.correo is string && request.resource.data.correo.size() <= 120
            && (!('nota' in request.resource.data) || (request.resource.data.nota is string && request.resource.data.nota.size() <= 500))
            && (!('servicio' in request.resource.data) || (request.resource.data.servicio is string && request.resource.data.servicio.size() <= 120))
            && request.resource.data.historial is list && request.resource.data.historial.size() == 1
            // inventario: solo con usuario de rol transitoria, y sin estado de cuadre
            && ((!('conteo' in request.resource.data) && request.resource.data.get('origen', '') != 'transitoria')
                || (isTransitoria() && request.resource.data.origen == 'transitoria'
                    && request.resource.data.conteo.keys().hasOnly(['bodegaId', 'bodega', 'inicio', 'fin', 'datosAl', 'items']))));
      // Quien pidió puede cambiar SU solicitud mientras siga «Nueva» (agregar, quitar, cambiar cantidades, nota),
      // sin tocar el estado, el número, su identidad ni lo que ya hizo bodega (v21.197).
      allow update: if isStaff()
        || (request.auth != null && resource.data.uid == request.auth.uid
            && resource.data.estado == 'NUEVA' && request.resource.data.estado == 'NUEVA'
            && request.resource.data.uid == resource.data.uid
            && !('conteo' in resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lineas', 'nota', 'servicio', 'solicitante', 'correo', 'editadoEn', 'historial'])
            && request.resource.data.lineas is list && request.resource.data.lineas.size() > 0 && request.resource.data.lineas.size() <= 80
            && request.resource.data.historial.size() == resource.data.historial.size() + 1)
        // Reconteo pedido por bodega: la encargada reenvía SOLO el conteo (bodega vuelve a revisar y acepta)
        || (isTransitoria() && resource.data.uid == request.auth.uid
            && resource.data.conteo.get('estado', '') == 'reconteo' && request.resource.data.conteo.get('estado', '') == 'recontado'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['conteo', 'historial', 'editadoEn'])
            && request.resource.data.conteo.bodegaId == resource.data.conteo.bodegaId
            && request.resource.data.conteo.bodega == resource.data.conteo.bodega
            && request.resource.data.conteo.fin == resource.data.conteo.fin
            && request.resource.data.historial.size() == resource.data.historial.size() + 1)
        // La encargada marca «Recibido» en su bodega; la sesión de bodega mueve lo que estaba en camino
        || (isTransitoria() && resource.data.estado == 'LISTA' && resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['recibidoSolicitado', 'historial'])
            && request.resource.data.historial.size() == resource.data.historial.size() + 1);
      allow delete: if isAdmin();
    }

    match /Solicitudes_Ajuste/{id} {
       allow read, write: if hasRole();
    }
    
    match /Auditoria/{id} {
       allow read, write: if isAdmin();
    }
    
    match /Configuracion/global {
      allow read: if hasRole(); // Lectura de configuracion general
      allow write: if isAdmin();
    }

    match /Metadata/{id} {
       allow read: if hasRole(); // Dashboard stats
       allow update, create: if hasRole(); // Utilizado por runTransaction
       allow write: if isAdmin();
    }

    // -----------------------------------------------------
    // SEGUIMIENTO DE ÓRDENES DE COMPRA (v20.36)
    // La bitácora (Eventos) es inmutable: solo se crea.
    // -----------------------------------------------------
    match /Seguimiento_OC/{ocId} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
      match /Eventos/{eventoId} {
        allow read, create: if isStaff();
        allow update, delete: if false;
      }
      // Archivos de la orden (v20.75): PDF guardados en partes; no se modifican
      match /Archivos/{archId} {
        allow read, create: if isStaff();
        allow update: if false;
        allow delete: if isAdmin();
        match /Partes/{parteId} {
          allow read, create: if isStaff();
          allow update: if false;
          allow delete: if isAdmin();
        }
      }
    }
    // CENTROS DE ENTREGA (v20.82): lista que se amplía al agregar un centro en Actas de entrega
    match /Centros_Entrega/{id} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
    }
    // CATÁLOGO DE PRODUCTOS (v20.76): se alimenta con las órdenes; foto opcional
    match /Catalogo_Productos/{id} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
    }
    // PRESUPUESTO POR CDP (v20.55): opcional; lo comprometido se calcula desde las órdenes
    match /CDP_Presupuesto/{id} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
    }
    // COMPRAS ÁGILES (v20.42): bitácora inmutable.
    match /Compras_Agiles/{id} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
      match /Eventos/{eventoId} {
        allow read, create: if isStaff();
        allow update, delete: if false;
      }
    }
    match /Actas_Entrega/{numero} {
      allow read, create: if isStaff();
      // administrador: EMITIDA → ANULADA (sin tocar los productos) o editar un acta EMITIDA (v20.93; cada edición deja su movimiento EDICION_ACTA)
      allow update: if isAdmin()
        && resource.data.estado == 'EMITIDA'
        && request.resource.data.numero == resource.data.numero
        && ((request.resource.data.estado == 'ANULADA' && request.resource.data.items == resource.data.items)
            || request.resource.data.estado == 'EMITIDA');
      allow delete: if false;
    }
    match /Equipos_Oxigeno/{equipoId} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
      match /Eventos/{eventoId} {
        allow read, create: if isStaff();
        allow update, delete: if false;
      }
    }
    match /Contadores/{id} {
      allow read: if isStaff() || (isTransitoria() && id.matches('transitoria-.*'))
        || (request.auth != null && id.matches('correlativo-solicitudes-[0-9]{4}'));
      allow create, update: if isStaff();
      // N° SOL al enviar desde «Pedir insumos» (v21.219): el contador sube de a 1 y solo junto con la solicitud que lleva ese número
      allow create: if request.auth != null && id.matches('correlativo-solicitudes-[0-9]{4}')
        && request.resource.data.keys().hasOnly(['valor', 'actualizado', 'ultima']) && request.resource.data.valor == 1
        && getAfter(/databases/$(database)/documents/Solicitudes_Insumos/$(request.resource.data.ultima)).data.correlativoN == 1;
      allow update: if request.auth != null && id.matches('correlativo-solicitudes-[0-9]{4}')
        && request.resource.data.keys().hasOnly(['valor', 'actualizado', 'ultima']) && request.resource.data.valor == resource.data.valor + 1
        && getAfter(/databases/$(database)/documents/Solicitudes_Insumos/$(request.resource.data.ultima)).data.correlativoN == request.resource.data.valor;
      allow delete: if false;
    }
    match /Config_Correo/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /ajustes_sistema/{id} {
       allow read, write: if isAdmin(); // Solo admin
    }

    // -----------------------------------------------------
    // GESTIÓN DE BANDEJAS DE TURNO
    // -----------------------------------------------------
    match /Bandejas_Turno/{bandejaId} {
      allow read: if hasRole(); // las bandejas antiguas pueden contener RUT de pacientes
      allow create, update: if hasRole();
      allow delete: if isAdmin() || getUserRole() == 'operador';
    }

    match /Bandejas_Turno/{bandejaId}/Auditoria_Turno/{auditId} {
      allow read, write: if hasRole();
    }

    // -----------------------------------------------------
    // GESTIÓN DE PLANTILLAS (PACKS)
    // -----------------------------------------------------
    match /Plantillas_Bandejas/{plantillaId} {
      allow read, write: if hasRole();
    }

    // -----------------------------------------------------
    // INTELIGENCIA OPERATIVA (Estadísticas SAR)
    // -----------------------------------------------------
    match /Estadisticas_Operativas/{id} {
       allow read, write: if isAdmin();
    }

    // -----------------------------------------------------
    // INVENTARIO SEMANAL, RACKS Y RESPALDOS EN LA NUBE
    // -----------------------------------------------------
    match /Grupos_Racks/{rackId} {
      allow read, write: if hasRole();
    }

    match /Inventarios_Semanales/{semanaId} {
      allow read, write: if hasRole();
    }

    match /Respaldos_Toma_Inventario/{backupId} {
      allow read, write: if hasRole();
    }

    // -----------------------------------------------------
    // COLECCIONES USADAS POR EL CLIENTE QUE NO TENÍAN REGLA
    // (sin regla Firestore deniega todo, por lo que fallaban)
    // -----------------------------------------------------
    match /Roles/{roleId} {
      allow read: if hasRole();      // matriz RBAC en la UI
      allow write: if isAdmin();
    }

    match /Solicitudes_Compra/{id} {
      allow read, create: if isOperadorOrAdmin();
      allow update, delete: if isAdmin();
    }

    // Módulo de compras (SDC, OC y recepciones). El borrado queda solo para administradores.
    match /ERP_SDC/{id} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
    }
    match /ERP_OC/{id} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
    }
    match /ERP_Recepciones/{id} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /Incidencias/{id} {
      allow read, create: if isOperadorOrAdmin();
      allow update: if false;        // bitácora inmutable
      allow delete: if isSuperAdmin();
    }
  }
}
