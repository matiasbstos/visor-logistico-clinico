{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "**/.*",
      "**/node_modules/**",
      "manager.js",
      "set-claims.js",
      "migrateData.js",
      "serviceAccountKey.json",
      "package.json",
      "package-lock.json",
      "*.docx",
      "backups/**",
      "backup_pre_stable/**",
      ".rollbacks/**",
      "_temp_test/**",
      "functions/**",
      "docs/**",
      "*.md",
      "*.py",
      "*.mjs",
      "firestore.indexes.json",
      "append.js",
      "append-clean.js",
      "check-users.js",
      "cleanup.js",
      "fix-*.js",
      "implement-rbac.js",
      "list-users.js",
      "make-superadmin.js",
      "merge_views.js",
      "publish-release.js",
      "remove-redundant.js",
      "reset-pwd.js",
      "restore.js",
      "seed-roles.js",
      "serve.js",
      "sync-deploy.js",
      "sync-users.js",
      "test-html.js",
      "update-user.js",
      "tmp_*",
      "script_backup*.js",
      "script.min.js",
      "patch.js",
      "patch-auth-leak.js",
      "patch-en-uso.js",
      "patch-enfermero.js",
      "patch-excel-logic.js",
      "patch-fase32-fix.js",
      "patch-fase32.js",
      "patch-fase34-1.js",
      "patch-fase34-2.js",
      "patch-fase34-3.js",
      "patch-finalizar.js",
      "patch-fusion.js",
      "patch-historial-2.js",
      "patch-historial-3.js",
      "patch-historial-append.js",
      "patch-historial.js",
      "patch-html-reqs.js",
      "patch-increment.js",
      "patch-index.js",
      "patch-logic-reqs.js",
      "patch-merma.js",
      "patch-operator-recepcion.js",
      "patch-recepcion-bodega.js",
      "patch-recepcion-logic.js",
      "patch-render.js",
      "patch-terminar.js",
      "patch-turno.js"
    ],
    "headers": [
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
