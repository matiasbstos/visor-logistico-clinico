rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // -----------------------------------------------------
    // FUNCIONES DE APOYO (HELPERS)
    // -----------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRoleByDoc(docId) {
      return exists(/databases/$(database)/documents/Usuarios/$(docId)) 
        ? get(/databases/$(database)/documents/Usuarios/$(docId)).data.get('rol', 
            get(/databases/$(database)/documents/Usuarios/$(docId)).data.get('role', 'sin_acceso')
          )
        : 'sin_acceso';
    }

    function getUserRole() {
      return (request.auth != null && 'email' in request.auth.token && exists(/databases/$(database)/documents/Usuarios/$(request.auth.token.email)))
        ? getUserRoleByDoc(request.auth.token.email)
        : (request.auth != null ? getUserRoleByDoc(request.auth.uid) : 'sin_acceso');
    }

    function isAdmin() {
      return getUserRole() in ['admin', 'superadmin', 'administrador', 'global', 'ADMIN', 'SUPERADMIN', 'ADMINISTRADOR', 'GLOBAL'];
    }

    function isSuperAdmin() {
      return getUserRole() in ['superadmin', 'SUPERADMIN'];
    }

    function isOperadorOrAdmin() {
      return getUserRole() in [
        'admin', 'superadmin', 'administrador', 'global', 'operador', 'enfermero',
        'ADMIN', 'SUPERADMIN', 'ADMINISTRADOR', 'GLOBAL', 'OPERADOR', 'ENFERMERO'
      ];
    }

    // Personal que gestiona compras y bodega (excluye al enfermero)
    function isStaff() {
      return getUserRole() in [
        'admin', 'superadmin', 'administrador', 'global', 'operador',
        'ADMIN', 'SUPERADMIN', 'ADMINISTRADOR', 'GLOBAL', 'OPERADOR'
      ];
    }

    function isOwner(userId) {
      // Comparación relajada para asegurar lectura propia
      return isAuthenticated() && (request.auth.uid == userId || request.auth.token.email == userId);
    }

    // Usuario autenticado que además tiene un rol asignado en /Usuarios.
    // Una cuenta recién registrada, sin perfil, queda como 'sin_acceso'.
    function hasRole() {
      return isAuthenticated() && getUserRole() != 'sin_acceso';
    }

    // Correo institucional REAL: dominio anclado tras la arroba y correo verificado.
    // (Firebase Auth no comprueba que el correo sea del dueño si no está verificado.)
    function isInstitutionalEmail() {
      return isAuthenticated()
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@(comunel|cormunel|cormumel)\\.cl');
    }

    // -----------------------------------------------------
    // GESTIÓN DE USUARIOS MÉTODOS RBAC
    // -----------------------------------------------------
    match /Usuarios/{userId} {
      // LECTURA: Operadores y admins pueden ver a todos (necesario para listar enfermeros).
      allow read: if isOperadorOrAdmin() || isOwner(userId);
      // CREACIÓN: admin, operador (solo enfermeros) o el propio titular con correo
      // institucional verificado que crea SU perfil inicial de superadmin (arranque).
      allow create: if isAdmin()
        || (getUserRole() == 'operador' && request.resource.data.rol == 'enfermero')
        || (isOwner(userId) && isInstitutionalEmail() && request.resource.data.rol == 'superadmin');
      // ACTUALIZACIÓN: Un usuario regular NO puede modificar su propio campo 'rol' o 'role'
      allow update: if isAdmin() || (isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['rol', 'role'])));
      allow delete: if isAdmin();
    }

    // -----------------------------------------------------
    // GESTIÓN DE BODEGAS (Sucursales)
    // -----------------------------------------------------
    match /Bodegas/{bodegaId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Estantes y ubicaciones de cada bodega (códigos como BS-A01). No se borran: se archivan.
    // Qué cantidad de cada producto hay en cada ubicación (el stock total sigue en Insumos).
    match /Asignaciones_Ubicacion/{id} {
      allow read: if hasRole();
      allow create, update, delete: if isStaff();
    }

    match /Bodegas/{bodegaId}/Ubicaciones/{codigo} {
      allow read: if hasRole();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // -----------------------------------------------------
    // CIBERSEGURIDAD: Reglas de la Colección 'Insumos'
    // -----------------------------------------------------
    match /Insumos/{insumoId} {
      allow read: if isAuthenticated();
      allow create: if isOperadorOrAdmin();
      allow update: if isOperadorOrAdmin();
      allow delete: if isAdmin();
    }
    
    // -----------------------------------------------------
    // AUDITORÍA INMUTABLE: Log de cambios locales
    // -----------------------------------------------------
    match /Insumos/{insumoId}/audit_logs/{logId} {
      allow create: if isAuthenticated() && request.resource.data.action == 'ACTUALIZACION';
      allow read: if isAdmin(); // Solo admins pueden auditar inventario detallado
      allow update: if false; 
      allow delete: if isSuperAdmin();
    }

    // -----------------------------------------------------
    // HISTORIAL GLOBAL (Bitácora de todos los movimientos)
    // -----------------------------------------------------
    match /Historial_Movimientos/{movId} {
      allow read: if hasRole(); // Solo usuarios con rol asignado (el historial antiguo puede contener RUT de pacientes)
      allow create: if isAuthenticated();
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // -----------------------------------------------------
    // INFORMES Y AUDITORÍA DE ERRORES
    // -----------------------------------------------------
    match /informes/{id} {
       allow read: if hasRole();   // el Inicio lee las fechas de inventario general
       allow write: if isAdmin();  // solo admin modificas
    }

    match /Logs_Sistema/{id} {
       allow read, write: if isAdmin();
    }
    
    match /Solicitudes_Criticas/{id} {
       allow read, write: if isAdmin();
    }

    match /Solicitudes_Ajuste/{id} {
       allow read, write: if isAuthenticated();
    }
    
    match /Auditoria/{id} {
       allow read, write: if isAdmin();
    }
    
    match /Configuracion/global {
      allow read: if isAuthenticated(); // Lectura de configuracion general
      allow write: if isAdmin();
    }

    match /Metadata/{id} {
       allow read: if isAuthenticated(); // Dashboard stats
       allow update, create: if isAuthenticated(); // Utilizado por runTransaction
       allow write: if isAdmin();
    }

    // -----------------------------------------------------
    // SEGUIMIENTO DE ÓRDENES DE COMPRA (v20.36)
    // La bitácora (Eventos) es inmutable: solo se crea.
    // -----------------------------------------------------
    match /Seguimiento_OC/{ocId} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
      match /Eventos/{eventoId} {
        allow read, create: if isStaff();
        allow update, delete: if false;
      }
    }
    match /Actas_Entrega/{numero} {
      allow read, create: if isStaff();
      // solo se puede pasar de EMITIDA a ANULADA (administrador); el resto del acta no cambia
      allow update: if isAdmin()
        && resource.data.estado == 'EMITIDA' && request.resource.data.estado == 'ANULADA'
        && request.resource.data.numero == resource.data.numero
        && request.resource.data.items == resource.data.items;
      allow delete: if false;
    }
    match /Equipos_Oxigeno/{equipoId} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
      match /Eventos/{eventoId} {
        allow read, create: if isStaff();
        allow update, delete: if false;
      }
    }
    match /Contadores/{id} {
      allow read, create, update: if isStaff();
      allow delete: if false;
    }
    match /Config_Correo/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /ajustes_sistema/{id} {
       allow read, write: if isAdmin(); // Solo admin
    }

    // -----------------------------------------------------
    // GESTIÓN DE BANDEJAS DE TURNO
    // -----------------------------------------------------
    match /Bandejas_Turno/{bandejaId} {
      allow read: if hasRole(); // las bandejas antiguas pueden contener RUT de pacientes
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin() || getUserRole() == 'operador';
    }

    match /Bandejas_Turno/{bandejaId}/Auditoria_Turno/{auditId} {
      allow read, write: if isAuthenticated();
    }

    // -----------------------------------------------------
    // GESTIÓN DE PLANTILLAS (PACKS)
    // -----------------------------------------------------
    match /Plantillas_Bandejas/{plantillaId} {
      allow read, write: if isAuthenticated();
    }

    // -----------------------------------------------------
    // INTELIGENCIA OPERATIVA (Estadísticas SAR)
    // -----------------------------------------------------
    match /Estadisticas_Operativas/{id} {
       allow read, write: if isAdmin();
    }

    // -----------------------------------------------------
    // INVENTARIO SEMANAL, RACKS Y RESPALDOS EN LA NUBE
    // -----------------------------------------------------
    match /Grupos_Racks/{rackId} {
      allow read, write: if isAuthenticated();
    }

    match /Inventarios_Semanales/{semanaId} {
      allow read, write: if isAuthenticated();
    }

    match /Respaldos_Toma_Inventario/{backupId} {
      allow read, write: if isAuthenticated();
    }

    // -----------------------------------------------------
    // COLECCIONES USADAS POR EL CLIENTE QUE NO TENÍAN REGLA
    // (sin regla Firestore deniega todo, por lo que fallaban)
    // -----------------------------------------------------
    match /Roles/{roleId} {
      allow read: if hasRole();      // matriz RBAC en la UI
      allow write: if isAdmin();
    }

    match /Solicitudes_Compra/{id} {
      allow read, create: if isOperadorOrAdmin();
      allow update, delete: if isAdmin();
    }

    // Módulo de compras (SDC, OC y recepciones). El borrado queda solo para administradores.
    match /ERP_SDC/{id} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
    }
    match /ERP_OC/{id} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
    }
    match /ERP_Recepciones/{id} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /Incidencias/{id} {
      allow read, create: if isOperadorOrAdmin();
      allow update: if false;        // bitácora inmutable
      allow delete: if isSuperAdmin();
    }
  }
}
